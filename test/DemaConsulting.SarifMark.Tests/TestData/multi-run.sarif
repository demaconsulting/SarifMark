{
    "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
    "version": "2.1.0",
    "runs": [
        {
            "tool": {
                "driver": {
                    "name": "Tool1",
                    "version": "1.0.0"
                }
            },
            "results": [
                {
                    "ruleId": "RULE001",
                    "level": "warning",
                    "message": {
                        "text": "A warning from Tool1"
                    },
                    "locations": [
                        {
                            "physicalLocation": {
                                "artifactLocation": {
                                    "uri": "file:///path/to/file1.cs"
                                },
                                "region": {
                                    "startLine": 10
                                }
                            }
                        }
                    ]
                }
            ],
            "artifacts": [
                { "location": { "uri": "file:///path/to/file1.cs" } }
            ]
        },
        {
            "tool": {
                "driver": {
                    "name": "Tool2",
                    "version": "2.0.0"
                }
            },
            "results": [],
            "artifacts": [
                { "location": { "uri": "file:///path/to/file2.cs" } },
                { "location": { "uri": "file:///path/to/file3.cs" } }
            ]
        }
    ]
}
