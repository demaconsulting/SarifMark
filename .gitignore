# .gitignore — C# / .NET project with Python and Node tooling

# Build outputs
bin/
obj/
artifacts/

# .NET
*.user
*.suo
*.rsuser
*.userosscache
*.sln.docstates
*.userprefs
*.bak
.vs/
*.slnx.user
*.DotSettings.user
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper

# JetBrains Rider
.idea/
*.sln.iml

# NuGet packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
project.lock.json
project.fragment.lock.json

# Python virtual environment
.venv/
__pycache__/
*.py[cod]
*$py.class

# Node
node_modules/
package-lock.json
npm-debug.log

# Generated compliance documents (build outputs — never committed)
**/generated/

# Test results
TestResults/
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
test-results/

# Code coverage
coverage/
*.coverage
*.coveragexml
*.opencover.xml

# VersionMark captures (generated during CI/CD)
versionmark-*.json

# Benchmark results
BenchmarkDotNet.Artifacts/

# Agent logs
.agent-logs/

# OS
.DS_Store
Thumbs.db
*.tmp
*.log